  <ReportParameters><ReportParameter Name="TiempoMinimo">
      <DataType>Integer</DataType>
      <DefaultValue><Values><Value>0</Value></Values></DefaultValue>
      <Prompt>Tiempo mínimo de preparación (minutos)</Prompt>
    </ReportParameter><ReportParameter Name="TiempoMaximo">
      <DataType>Integer</DataType>
      <DefaultValue><Values><Value>120</Value></Values></DefaultValue>
      <Prompt>Tiempo máximo de preparación (minutos)</Prompt>
    </ReportParameter></ReportParameters>
