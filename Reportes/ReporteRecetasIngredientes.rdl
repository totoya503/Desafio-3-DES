<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="RecetasDB">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=RecetasDB</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsRecetasIngredientes">
      <Query>
        <DataSourceName>RecetasDB</DataSourceName>
        <QueryParameters><QueryParameter Name="@TiempoMinimo"><Value>=Parameters!TiempoMinimo.Value</Value></QueryParameter><QueryParameter Name="@TiempoMaximo"><Value>=Parameters!TiempoMaximo.Value</Value></QueryParameter></QueryParameters>
        <CommandText>SELECT r.Id AS RecetaId,
       r.Nombre AS Receta,
       r.Descripcion,
       r.TiempoPreparacion,
       i.Nombre AS Ingrediente,
       i.Cantidad,
       i.UnidadMedida
FROM Recetas r
LEFT JOIN Ingredientes i ON i.RecetaId = r.Id
WHERE r.TiempoPreparacion BETWEEN @TiempoMinimo AND @TiempoMaximo
ORDER BY r.TiempoPreparacion, r.Nombre, i.Nombre</CommandText>
      </Query>
      <Fields><Field Name="RecetaId"><DataField>RecetaId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Receta"><DataField>Receta</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Descripcion"><DataField>Descripcion</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TiempoPreparacion"><DataField>TiempoPreparacion</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Ingrediente"><DataField>Ingrediente</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Cantidad"><DataField>Cantidad</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="UnidadMedida"><DataField>UnidadMedida</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
