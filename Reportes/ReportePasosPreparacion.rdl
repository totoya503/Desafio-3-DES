  <DataSets>
    <DataSet Name="dsPasosPreparacion">
      <Query>
        <DataSourceName>RecetasDB</DataSourceName>
        <CommandText>SELECT r.Id AS RecetaId,
       r.Nombre AS Receta,
       r.TiempoPreparacion,
       COUNT(p.Id) OVER (PARTITION BY r.Id) AS TotalPasos,
       p.Orden,
       p.Descripcion AS Paso
FROM Recetas r
LEFT JOIN PasosPreparacion p ON p.RecetaId = r.Id
ORDER BY r.Nombre, p.Orden</CommandText>
      </Query>
      <Fields>
        <Field Name="RecetaId">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>RecetaId</DataField>
        </Field>
        <Field Name="Receta">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Receta</DataField>
        </Field>
        <Field Name="TiempoPreparacion">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>TiempoPreparacion</DataField>
        </Field>
        <Field Name="TotalPasos">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>TotalPasos</DataField>
        </Field>
        <Field Name="Orden">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Orden</DataField>
        </Field>
        <Field Name="Paso">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Paso</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
