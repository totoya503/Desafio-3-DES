    </TextRun></TextRuns>
    <Style><TextAlign>Left</TextAlign></Style>
  </Paragraph></Paragraphs>
  <Top>0in</Top><Left>0in</Left><Height>0.4in</Height><Width>6.5in</Width>
  <Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
</Textbox>
          <Textbox Name="txtSubtitulo">
  <CanGrow>true</CanGrow>
  <KeepTogether>true</KeepTogether>
  <Paragraphs><Paragraph>
    <TextRuns><TextRun>
      <Value>="Tiempo de preparación entre " &amp; Parameters!TiempoMinimo.Value &amp; " y " &amp; Parameters!TiempoMaximo.Value &amp; " minutos  ·  Recetas encontradas: " &amp; CountDistinct(Fields!RecetaId.Value, "dsRecetasIngredientes")</Value>
      <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><Color>#555555</Color></Style>
    </TextRun></TextRuns>
    <Style><TextAlign>Left</TextAlign></Style>
  </Paragraph></Paragraphs>
